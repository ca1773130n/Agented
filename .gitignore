# Node version path (generated by justfile ensure-node)
.node-path

# Python
__pycache__/
*.pyc
*.egg-info/
.coverage

# Node
node_modules/

# Build / test artifacts
dist/
coverage/
test-results/
playwright-report/
test-dashboard.mjs

# Tooling
.playwright-mcp/
.aider.conf.yml
.avante/
.clinerules
.codecompanion/
.continue/
.cursor/
.harness-sync/
.roo/
.superpowers/
.zed/
.agents/
.codeium/
.codex/
.gemini/
.opencode/
.rules
codex.toml
opencode.json
# Per-machine Claude Code state (not the whole .claude/ — skills/commands stay tracked)
.claude/settings.json
.claude/scheduled_tasks.lock
# Auto-generated agented-takeaway skill packages (operator-curated
# skills under .claude/skills/ STAY tracked; only this subdir is
# ignored). Re-deriveable from session_takeaways.
.claude/skills/.agented-takeaways/

# Local data
backend/data/
# Generated bot working directories (created at runtime by ExecutionService)
backend/backend_dirs/
# Bundle install staging (generated by ai-accounts bundle-install)
temp_bundles/

# Runtime
*.db
project_links/
data/trigger_events/
.claude/skills/weekly-security-audit/reports/

# Environment / secrets
.env
.env.*
!.env.example
backend/.secret_key
.serena/
.worktrees/

# SQLite WAL/SHM sidecar files (not part of the schema; vary per-process)
*.db-shm
*.db-wal
*.db-journal

# OS junk
.DS_Store

# Ad-hoc debug captures from manual repro sessions (screenshots, console
# dumps, snapshot YAMLs). Land at repo root during local debugging; never
# meant to be committed.
/console*.log
/codex-*.png
/wizard-*.png
/onboarding-*.png
/snap-*.yml
# Throwaway SQLite scratch DBs from local smoke/test runs.
/tmp*.db


# /understand analysis caches — keep top-level outputs only
.understand-anything/intermediate/
.understand-anything/tmp/

# Life-Harness T3 evolution scratch dirs. The evolver calls
# ``tempfile.mkdtemp`` which is supposed to land them in $TMPDIR; in
# sandbox environments where TMPDIR is unset and the default falls
# through to the CWD, they end up here. The dir contents are the per-
# round Codex workspace (harness.json + trajectories/) and are never
# meant to be committed.
/agented-harness-evolution-*/

# Tesserae per-project workspace (compiled graph + harness sessions —
# regenerable from source, per-machine state).
.tesserae/

# Sandbox/CI temp + tool caches that land at the repo root because $TMPDIR
# falls through to the CWD in some environments. None are ever meant to be
# committed (the same root cause noted for agented-harness-evolution above).
pytest-of-neo/
/agented-eval-*/
/agented-tess-smoke-*/
node-compile-cache/
torchinductor_*/
tsx-*/
.deepeval/
backend/.deepeval/
# Stray per-process uv lock copies (the real lock is backend/uv.lock, tracked).
/uv-*.lock
backend/uv-*.lock
# Runtime logs (not source; dirty every run).
*.log
!.gitkeep
# Ad-hoc local artifacts that recur at root during dev sessions.
backend/~/

# VitePress docs site (build cache + output + local deps)
docs/.vitepress/cache/
docs/.vitepress/dist/
docs/node_modules/
