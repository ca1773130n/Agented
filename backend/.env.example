# ==============================================================
# Agented Backend Configuration
# ==============================================================
# Copy this file to .env and adjust values as needed.
# All variables have sensible defaults for local development.
# Shell-set environment variables take precedence over .env values.

# --- Security ---
# Flask session signing key (string, no default).
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
# If not set, a key is auto-generated and persisted to .secret_key file.
# SECRET_KEY=

# API key for authenticating requests to /admin/* and /api/* endpoints.
# When set, all requests must include X-API-Key header with this value.
# When unset, authentication is disabled (backward compatible).
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
# AGENTED_API_KEY=

# Close open self-registration (0 or 1, default: unset/open).
# Open by default so the FIRST registrant becomes admin. Set to 1 once you have
# registered, and ALWAYS before exposing the instance to an untrusted network --
# otherwise an attacker could race to be the first signup and gain admin.
# Surfaced to the SPA via signup_enabled in /health/auth-status.
# AGENTED_DISABLE_SIGNUP=1

# Honor X-Forwarded-* headers (0 or 1, default: 0). Enable ONLY behind a trusted
# reverse proxy, otherwise clients can spoof their address.
# AGENTED_TRUST_PROXY=0

# Send HSTS (Strict-Transport-Security) headers (default: off). Enabled by the
# LITERAL string "true" only. NOTE: this does NOT redirect http->https; it just
# adds the HSTS header (meaningful once you terminate TLS in front of the app).
# FORCE_HTTPS=true

# Secure flag on session cookies (default: unset = follow the request scheme --
# Secure on https, not on http). Set to 1 to force Secure regardless of scheme.
# AGENTED_COOKIE_SECURE=1

# Reject unsigned GitHub webhooks (0 or 1, default: 0). Pair with GITHUB_WEBHOOK_SECRET.
# AGENTED_REQUIRE_WEBHOOK_SIGNATURE=0

# Key(s) for at-rest encryption of stored credentials (string, no default).
# AGENTED_VAULT_KEYS=

# --- Server ---
# Gunicorn bind address and port (string, default: 0.0.0.0:20000)
# GUNICORN_BIND=0.0.0.0:20000

# Log level: debug, info, warning, error, critical (string, default: info)
# LOG_LEVEL=info

# --- Logging ---
# Log output format: json for structured JSON, text for human-readable (string, default: json)
# LOG_FORMAT=json

# --- Error Tracking (Sentry) ---
# Sentry DSN for error tracking (string, no default -- Sentry disabled when unset)
# Get your DSN from: sentry.io -> Project Settings -> Client Keys (DSN)
# SENTRY_DSN=

# Sentry performance transaction sampling rate (float 0.0-1.0, default: 0.1)
# 0.1 = sample 10% of requests for performance monitoring
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Sentry environment tag (string, default: production)
# SENTRY_ENVIRONMENT=production

# Sentry release tag (string, default: agented@0.1.0)
# SENTRY_RELEASE=agented@0.1.0

# --- CORS ---
# Comma-separated list of allowed origins (string, default: empty -- blocks all cross-origin)
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database ---
# SQLite database file path (string, default: backend/agented.db)
# AGENTED_DB_PATH=

# --- GitHub ---
# HMAC-SHA256 secret for verifying GitHub webhook signatures (string, no default)
# GITHUB_WEBHOOK_SECRET=

# --- AI / LLM ---
# Anthropic API key for direct API access (string, no default)
# ANTHROPIC_API_KEY=

# Anthropic API base URL for proxy setups (string, no default)
# ANTHROPIC_API_BASE=

# --- AI-accounts sidecar (:20001) ---
# Token for the ai-accounts sidecar (scripts/run_ai_accounts.py).
# When unset, the sidecar reads the admin key from agented.db's user_roles table.
# AI_ACCOUNTS_API_KEY=

# Allow the sidecar to run with NO keyed identity (default: unset = auth enforced).
# When unset the sidecar requires a key (refusing to start if none can be resolved,
# so it never silently falls back to NoAuth). Set to 1 ONLY for local dev with no
# key yet (e.g. just after `just reset`).
# AI_ACCOUNTS_ALLOW_NOAUTH=1

# Base URL the backend uses to reach the sidecar (string, default: http://127.0.0.1:20001)
# AI_ACCOUNTS_SIDECAR_URL=http://127.0.0.1:20001

# --- Plugins ---
# Path to GRD CLI binary directory (string, no default)
# CLAUDE_PLUGIN_ROOT=

# --- External Tool Homes ---
# Codex CLI config directory (string, default: ~/.codex)
# CODEX_HOME=

# Gemini CLI config directory (string, default: ~/.gemini)
# GEMINI_CLI_HOME=

# OpenCode config directory (string, default: ~/.opencode)
# OPENCODE_HOME=

# Working directory for skills playground (string, no default)
# SKILLS_PLAYGROUND_CWD=

# --- Features / autonomy ---
# DANGEROUS -- autonomous code execution. Default: unset = OFF.
# To ENABLE, set it to 1. To DISABLE, leave it UNSET (or remove the line) --
# the code treats ANY non-empty value as ON, so AGENTED_STRATEGY_AUTOIMPLEMENT=0
# (or =false) still ENABLES it. Do not set it unless you mean to.
# When on, the competitor-intel "Auto-implement" button can launch a coding agent
# (goal-loop) that writes code in an ISOLATED git worktree (.worktrees/strategy-<id>)
# -- never your main checkout. Even then it stays gated by the §5B legal checklist,
# an explicit operator confirm, and an on-exit human gate (you approve before the
# agent's work lands).
# AGENTED_STRATEGY_AUTOIMPLEMENT=1

# Enable the autoresearch metric-judge kernel (default: 0). Enabled only when set
# to the literal "1".
# AUTORESEARCH_KERNEL_ENABLED=1

# --- Tuning ---
# Stale conversation cleanup threshold in seconds (int, default: 1800)
# STALE_CONVERSATION_THRESHOLD_SECS=1800

# Stale execution cleanup threshold in seconds (int, default: 900)
# STALE_EXECUTION_THRESHOLD_SECS=900

# SSE replay buffer size (int, default: 500)
# SSE_REPLAY_LIMIT=500

# --- Timezone ---
# Timezone override, e.g. America/New_York (string, no default -- uses system timezone)
# TZ=

# --- Experimental ---
# Enable experimental agent teams feature (0 or 1, default: unset/disabled)
# CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=0

# --- Frontend dev (set for `vite dev`, not the backend -- here for reference) ---
# Bind interface for vite dev (string, default: 127.0.0.1). Set 0.0.0.0 to demo
# from another device (also set AI_ACCOUNTS_API_KEY + VITE_ALLOWED_HOSTS).
# VITE_HOST=127.0.0.1

# Comma-separated Host allowlist for LAN access (string, default: unset/any host).
# VITE_ALLOWED_HOSTS=
