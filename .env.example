# Agented production environment template.
# Copy to `.env` and fill in real values. Never commit `.env`.

# === Required for production (AGENTED_ENV=production) ===

# Backend admin API key. Generate with: openssl rand -hex 32
AGENTED_API_KEY=                    # SECRET — do not commit

# Sidecar admin API key. May reuse AGENTED_API_KEY.
AI_ACCOUNTS_API_KEY=                # SECRET — do not commit

# Sidecar vault encryption key. Required in production.
# Generate with: openssl rand -base64 32
AI_ACCOUNTS_VAULT_KEY=              # SECRET — encrypts the per-account vault

# Deployment posture. Must be "production" for prod deploys; defaults
# to development behavior when unset.
AGENTED_ENV=production

# === Optional overrides (defaults shown) ===

# LOG_LEVEL=info
# GUNICORN_BIND=0.0.0.0:20000
# VITE_HOST=127.0.0.1
# VITE_ALLOWED_HOSTS=

# === Docker-secrets / mounted-file alternative ===
# Set FOO_FILE=/run/secrets/foo to read FOO's value from the file at boot.
# AGENTED_API_KEY_FILE=/run/secrets/agented_api_key
# AI_ACCOUNTS_API_KEY_FILE=/run/secrets/ai_accounts_api_key
# AI_ACCOUNTS_VAULT_KEY_FILE=/run/secrets/ai_accounts_vault_key
