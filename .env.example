# Agented production environment template.
# Copy to `.env` and fill in real values. Never commit `.env`.

# === Required for production (AGENTED_ENV=production) ===

# Backend admin API key. Generate with: openssl rand -hex 32
AGENTED_API_KEY=                    # SECRET — do not commit

# Sidecar admin API key. May reuse AGENTED_API_KEY.
AI_ACCOUNTS_API_KEY=                # SECRET — do not commit

# Sidecar vault encryption key. Required in production.
# Generate with: openssl rand -base64 32
AI_ACCOUNTS_VAULT_KEY=              # SECRET — encrypts the per-account vault

# Backend secrets-vault Fernet keys (comma-separated). First key is the
# encryption key; later keys allow rotated entries to decrypt during
# transition windows.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGENTED_VAULT_KEYS=                 # SECRET — required for /admin/secrets/* routes

# Deployment posture. Must be "production" for prod deploys; defaults
# to development behavior when unset.
AGENTED_ENV=production

# === Optional overrides (defaults shown) ===

# AGENTED_DB_PATH=/app/data/agented.db   # Container default; defaults to backend/agented.db on host.
# LOG_LEVEL=info
# LOG_FORMAT=text                        # 'json' for structured production logs.
# GUNICORN_BIND=0.0.0.0:20000

# Healthcheck CLI overrides (used by `just healthcheck`):
# AGENTED_BACKEND_URL=http://127.0.0.1:20000
# AGENTED_SIDECAR_URL=http://127.0.0.1:20001

# Frontend dev-server (unused in container deploy):
# VITE_HOST=127.0.0.1
# VITE_ALLOWED_HOSTS=

# Optional integrations:
# ANTHROPIC_API_KEY=                  # SECRET — per-account vault is canonical store
# GITHUB_WEBHOOK_SECRET=              # SECRET — verify webhook signatures
# GITHUB_TOKEN=                       # SECRET — recommend macOS Keychain export
# CORS_ALLOWED_ORIGINS=               # comma-separated allowlist
# SENTRY_DSN=                         # SECRET
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=v0.5.13

# Sidecar dev fallback (DO NOT SET in production):
# AI_ACCOUNTS_ALLOW_NOAUTH=1

# === Rate limiting (v0.5.14) ===
# Defaults shown; raise for trusted-network deploys, lower for internet-facing.
# RATE_LIMIT_API_GET_PER_MIN=60
# RATE_LIMIT_API_WRITE_PER_MIN=30
# RATE_LIMIT_ADMIN_PER_MIN=30
# Per-route override on /api/auth/login is hardcoded at 5/min — set this
# var only for documentation / future override usage.
# RATE_LIMIT_LOGIN_PER_MIN=5

# === Backups (v0.5.15) ===
# Local snapshot directory (created lazily). Defaults to backend/backups/.
# AGENTED_BACKUP_DIR=/var/agented/backups
# Optional off-site sync. {file} is replaced by the snapshot path. Examples:
#   rclone copy {file} agented-backup:
#   aws s3 cp {file} s3://agented-backups/
#   scp {file} backup-host:agented/
# BACKUP_REMOTE_CMD=
# Days to retain local snapshots (older files deleted after each run).
# BACKUP_RETENTION_DAYS=30

# === Observability (v0.6.2) ===
# SlowRequestMiddleware logs WARN when a request exceeds this many ms.
# SLOW_REQUEST_THRESHOLD_MS=500

# === Docker-secrets / mounted-file alternative ===
# Set FOO_FILE=/run/secrets/foo to read FOO's value from the file at boot.
# AGENTED_API_KEY_FILE=/run/secrets/agented_api_key
# AI_ACCOUNTS_API_KEY_FILE=/run/secrets/ai_accounts_api_key
# AI_ACCOUNTS_VAULT_KEY_FILE=/run/secrets/ai_accounts_vault_key
# AGENTED_VAULT_KEYS_FILE=/run/secrets/agented_vault_keys
