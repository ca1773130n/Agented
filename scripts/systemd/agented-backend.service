# v0.5.13: Linux systemd user-service template for Agented backend.
#
# CUSTOMIZE BEFORE INSTALL:
#   1. Replace REPLACE_ME_REPO_PATH with your absolute Agented checkout path.
#   2. Replace REPLACE_ME_HOME with $HOME (e.g., /home/operator).
#   3. Verify EnvironmentFile points to your .env (chmod 600).
#
# INSTALL (as the operator user, not root):
#   mkdir -p ~/.config/systemd/user
#   cp scripts/systemd/agented-backend.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now agented-backend.service
#   systemctl --user status agented-backend
#
# LOGS:
#   journalctl --user -u agented-backend -f

[Unit]
Description=Agented backend (Litestar + gunicorn)
Documentation=https://github.com/ca1773130n/Agented/blob/main/docs/deploy/RUNBOOK.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=REPLACE_ME_REPO_PATH/backend
EnvironmentFile=REPLACE_ME_REPO_PATH/.env
Environment=AGENTED_ENV=production
ExecStart=REPLACE_ME_HOME/.local/bin/uv run gunicorn -c gunicorn.conf.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
