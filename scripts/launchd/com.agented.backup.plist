<?xml version="1.0" encoding="UTF-8"?>
<!--
  v0.5.15: macOS launchd template for daily Agented SQLite backup.
  Runs `just backup` at 03:00 local time every day.

  CUSTOMIZE BEFORE INSTALL:
    1. Replace REPLACE_ME_REPO_PATH with your absolute Agented checkout path.
    2. Verify ~/.zshrc exports AGENTED_BACKUP_DIR / BACKUP_REMOTE_CMD /
       BACKUP_RETENTION_DAYS, OR set EnvironmentVariables below directly.
    3. Adjust StartCalendarInterval if you want a different time.

  INSTALL:
    cp scripts/launchd/com.agented.backup.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.agented.backup.plist

  TRIGGER NOW (test):
    launchctl start com.agented.backup
    tail -f REPLACE_ME_REPO_PATH/backend/backup.log
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agented.backup</string>

    <!-- /bin/zsh -lc sources ~/.zshrc so AGENTED_BACKUP_DIR + BACKUP_REMOTE_CMD
         are available (consistent with v0.5.13 service plists). -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd REPLACE_ME_REPO_PATH &amp;&amp; just backup</string>
    </array>

    <key>WorkingDirectory</key>
    <string>REPLACE_ME_REPO_PATH</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>REPLACE_ME_REPO_PATH/backend/backup.log</string>

    <key>StandardErrorPath</key>
    <string>REPLACE_ME_REPO_PATH/backend/backup.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>AGENTED_ENV</key>
        <string>production</string>
    </dict>
</dict>
</plist>
